<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Profile Picture -->
        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_black_24dp"
            android:background="@drawable/circle_background" />

        <!-- Name -->
        <TextView
            android:id="@+id/profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Risky Firdaus"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Birthdate -->
        <TextView
            android:id="@+id/profile_birthdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum di Setel"
            android:textSize="14sp"
            android:textColor="@color/gray" />

        <!-- Navigation Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <!-- My Saved -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:text="My Saved"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/saved"
                android:drawablePadding="12dp"
                android:contentDescription="My Saved Icon" />


            <!-- Setting -->
            <Button
                android:id="@+id/settingProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:text="Setting"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/setting"
                android:drawablePadding="12dp"
                android:contentDescription="Setting Icon" />

            <!-- FAQs -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:text="FAQs"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/fag"
                android:drawablePadding="12dp"
                android:contentDescription="FAQs Icon" />

            <!-- Logout -->
            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:text="Logout"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/logout"
                android:drawablePadding="12dp"
                android:contentDescription="Logout Icon" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>