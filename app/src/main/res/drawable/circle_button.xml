<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval"
    >

    <!-- Background color -->
    <solid android:color="#E1F2F5" />

    <!-- Border -->
    <stroke
        android:width="2dp"
        android:color="@color/light_gray" />

    <!-- Padding (optional) -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>